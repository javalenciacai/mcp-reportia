{
  "name": "@james.valencia/mcp-reportia",
  "version": "0.1.2",
  "description": "Servidor MCP (Model Context Protocol) independiente que envuelve la API HTTP real de Reportia. Pensado para ser consumido por otra aplicación de IA vía npx/stdio.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mcp-reportia": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/jsonrpc-smoke.mjs",
    "test:integration": "node scripts/integration-smoke.mjs dist/server.js",
    "start": "node dist/server.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reportia",
    "typescript",
    "stdio",
    "ai",
    "npx"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "undici": "^6.21.0",
    "zod": "~3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/javalenciacai/mcp-reportia"
  },
  "bugs": {
    "url": "https://github.com/javalenciacai/mcp-reportia/issues"
  },
  "homepage": "https://github.com/javalenciacai/mcp-reportia#readme",
  "mcpName": "io.github.javalenciacai/mcp-reportia"
}
