# ============================================================
# Configuración del MCP de Reportia
# ============================================================
# Todas las variables son leídas al arrancar el proceso stdio.
# No copies secretos reales desde .env de Reportia.

# URL base de la API de Reportia (sin slash final)
# Ejemplos:
#   http://localhost:5000
#   https://reportia.tu-dominio.com
REPORTIA_BASE_URL=http://localhost:5000

# --- Autenticación (elige UN modo) ---
# Modo credenciales (recomendado para sesiones largas):
REPORTIA_EMAIL=
REPORTIA_PASSWORD=

# Modo token Bearer (alternativa para integraciones M2M):
# Si está presente y REPORTIA_EMAIL/PASSWORD están vacíos,
# se enviará Authorization: Bearer <token>.
REPORTIA_TOKEN=

# --- Opcionales ---
# ID de empresa por defecto. Si se omite, las herramientas lo pedirán.
REPORTIA_COMPANY_ID=

# Timeout por petición HTTP en milisegundos (default 30000)
REPORTIA_TIMEOUT_MS=30000

# Directorio donde se guardan los archivos exportados (Excel/PDF)
# Si está vacío, se usa ./downloads relativo al cwd del MCP.
REPORTIA_DOWNLOAD_DIR=

# User-Agent para identificar el MCP en los logs de Reportia
REPORTIA_USER_AGENT=mcp-reportia/0.1.0